{
  "schema_version": 1,
  "description": "Детекция секретов. Паттерны перенесены из secret_redactor.py v1.x без изменений (PLAN.md 0.9): поведение обкатано, регрессия недопустима. Порядок значим — PRIVATE_KEY проверяется первым, иначе внутренние строки блока ключа успевают совпасть с другими правилами.",
  "rules": [
    {
      "id": "secret-private-key",
      "class": "secret-output",
      "severity": "CRITICAL",
      "secret_type": "PRIVATE_KEY",
      "match": {
        "kind": "regex",
        "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY-----[\\s\\S]+?-----END (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY-----",
        "group": 0
      },
      "message": "В данных обнаружен блок приватного ключа.",
      "remediation": "Держите ключи вне репозитория и вне вывода команд: ssh-agent, gpg-agent или менеджер секретов.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-aws-access-key-id",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "AWS_ACCESS_KEY_ID",
      "match": {
        "kind": "regex",
        "pattern": "\\b(?:AKIA|ASIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA)[0-9A-Z]{16}\\b",
        "group": 0
      },
      "message": "Идентификатор ключа доступа AWS.",
      "remediation": "Используйте профили AWS CLI и переменные окружения вместо литералов; при утечке — отзыв ключа в IAM.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-github-token",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "GITHUB_TOKEN",
      "match": {
        "kind": "regex",
        "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b",
        "group": 0
      },
      "message": "Токен GitHub.",
      "remediation": "Храните токен в gh auth login или в переменной окружения; при утечке — отзыв в Settings → Developer settings.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-github-pat",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "GITHUB_PAT",
      "match": {
        "kind": "regex",
        "pattern": "\\bgithub_pat_[A-Za-z0-9_]{22,}\\b",
        "group": 0
      },
      "message": "Fine-grained personal access token GitHub.",
      "remediation": "Отзовите токен и выдайте новый с минимальным набором прав и сроком действия.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-stripe-key",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "STRIPE_KEY",
      "match": {
        "kind": "regex",
        "pattern": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}\\b",
        "group": 0
      },
      "message": "Ключ Stripe.",
      "remediation": "Отзовите ключ в дашборде Stripe; для разработки используйте только test-ключи из переменных окружения.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-llm-api-key",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "OPENAI_ANTHROPIC_KEY",
      "match": {
        "kind": "regex",
        "pattern": "\\bsk-(?:ant-)?(?:proj-)?[A-Za-z0-9_-]{20,}\\b",
        "group": 0
      },
      "message": "Ключ API языковой модели (OpenAI / Anthropic).",
      "remediation": "Отзовите ключ в консоли провайдера; передавайте его через переменную окружения, а не аргументом команды.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-slack-token",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "SLACK_TOKEN",
      "match": {
        "kind": "regex",
        "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b",
        "group": 0
      },
      "message": "Токен Slack.",
      "remediation": "Отзовите токен в настройках приложения Slack и перевыпустите его.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-slack-webhook",
      "class": "secret-output",
      "severity": "MEDIUM",
      "secret_type": "SLACK_WEBHOOK",
      "match": {
        "kind": "regex",
        "pattern": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/_-]+",
        "group": 0
      },
      "message": "Входящий webhook Slack — фактически ключ на запись в канал.",
      "remediation": "Пересоздайте webhook; храните URL в секретах CI, а не в коде.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-google-api-key",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "GOOGLE_API_KEY",
      "match": {
        "kind": "regex",
        "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b",
        "group": 0
      },
      "message": "Ключ API Google.",
      "remediation": "Ограничьте ключ по IP и API в Google Cloud Console либо перевыпустите его.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-google-oauth-token",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "GOOGLE_OAUTH_TOKEN",
      "match": {
        "kind": "regex",
        "pattern": "\\bya29\\.[0-9A-Za-z_-]{20,}",
        "group": 0
      },
      "message": "Токен доступа Google OAuth.",
      "remediation": "Токен короткоживущий, но действующий: не логируйте его и не передавайте в аргументах команд.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-npm-token",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "NPM_TOKEN",
      "match": {
        "kind": "regex",
        "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b",
        "group": 0
      },
      "message": "Токен npm.",
      "remediation": "Отзовите токен: npm token revoke <id>. Для CI используйте granular access token.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-jwt",
      "class": "secret-output",
      "severity": "MEDIUM",
      "secret_type": "JWT",
      "match": {
        "kind": "regex",
        "pattern": "\\beyJ[A-Za-z0-9_-]{6,}\\.eyJ[A-Za-z0-9_-]{6,}\\.[A-Za-z0-9_-]{6,}\\b",
        "group": 0
      },
      "message": "JSON Web Token — как правило, действующая сессия или ключ доступа.",
      "remediation": "Не передавайте JWT в аргументах команд и в URL; для отладки используйте payload без подписи.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-bearer-token",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "BEARER_TOKEN",
      "match": {
        "kind": "regex",
        "pattern": "(?i)\\bbearer\\s+([A-Za-z0-9._~+/-]{16,}=*)",
        "group": 1
      },
      "message": "Заголовок Authorization с bearer-токеном.",
      "remediation": "Передавайте токен через переменную окружения: curl -H \"Authorization: Bearer $TOKEN\".",
      "reference": "docs/RUNBOOK.md#secret-egress"
    },
    {
      "id": "secret-url-credentials",
      "class": "secret-output",
      "severity": "HIGH",
      "secret_type": "URL_CREDENTIALS",
      "match": {
        "kind": "regex",
        "pattern": "\\b[a-zA-Z][a-zA-Z0-9+.\\-]*://[^\\s:@/]+:([^\\s:@/]{6,})@",
        "group": 1
      },
      "message": "Учётные данные внутри URL.",
      "remediation": "Вынесите пароль в переменную окружения или в ~/.pgpass; URL с паролем попадает в историю команд и в логи.",
      "reference": "docs/RUNBOOK.md#secret-egress"
    },
    {
      "id": "secret-env-assignment",
      "class": "secret-output",
      "severity": "MEDIUM",
      "secret_type": "ENV_SECRET",
      "match": {
        "kind": "regex",
        "pattern": "\\b([A-Z0-9_]*(?:SECRET|TOKEN|PASSWORD|PASSWD|APIKEY|API_KEY|ACCESS_KEY|PRIVATE_KEY|CREDENTIALS?|AUTH)[A-Z0-9_]*)\\s*[=:]\\s*[\"']?([A-Za-z0-9_\\-+/=~]{6,})",
        "group": 2
      },
      "message": "Присваивание значения переменной, имя которой указывает на секрет.",
      "remediation": "Читайте значение из менеджера секретов или .env вне репозитория; в примерах используйте плейсхолдер.",
      "reference": "docs/RUNBOOK.md#secret-output"
    },
    {
      "id": "secret-high-entropy",
      "class": "secret-output",
      "severity": "LOW",
      "secret_type": "HIGH_ENTROPY",
      "enabled": false,
      "match": {
        "kind": "entropy",
        "min_entropy": 4.5,
        "min_length": 32,
        "charset": "[A-Za-z0-9+/=_-]+"
      },
      "message": "Строка высокой энтропии — возможен неизвестный формат ключа.",
      "remediation": "Проверьте вручную. Правило выключено по умолчанию: на пилоте доля ложных срабатываний неприемлема (ADR-003).",
      "reference": "docs/RUNBOOK.md#secret-output"
    }
  ]
}
