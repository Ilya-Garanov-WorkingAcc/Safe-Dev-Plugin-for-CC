__pycache__/
*.pyc
.claude/
.mcp.json

# Артефакты WSL при копировании файлов из Windows
*:Zone.Identifier

# Локальные данные плагина: журнал, реестр доверия, состояние сессий.
# Их место — ${CLAUDE_PLUGIN_DATA}, но при запуске вне плагина работает
# фолбэк, и каталог может оказаться рядом.
data/
audit/
trust/
state/

# policy.lock.json НЕ игнорируется: эталонный хеш политики — часть релиза,
# именно по нему heartbeat отличает подменённую политику от штатной.
